{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Static hosting for the studio info page. Asset-only Worker — no `main`.
  "name": "presentation-studio",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./site",
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true },

  "env": {
    "production": {
      "name": "presentation-studio",
      "workers_dev": false,
      "assets": {
        "directory": "./site",
        "not_found_handling": "single-page-application"
      },
      "routes": [
        { "pattern": "presentation.studio.appneural.com", "custom_domain": true }
      ],
      "observability": { "enabled": true }
    },

    "dev": {
      "name": "presentation-studio-dev",
      "workers_dev": true,
      "assets": {
        "directory": "./site",
        "not_found_handling": "single-page-application"
      },
      "routes": [
        { "pattern": "presentation-dev.studio.appneural.com", "custom_domain": true }
      ],
      "observability": { "enabled": true }
    }
  }
}
